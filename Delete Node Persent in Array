class Solution {
public:
    ListNode* modifiedList(vector<int>& nums, ListNode* head) {
        set<int> st;

        for(int x : nums)
            st.insert(x);

        while(head != NULL && st.count(head->val))
            head = head->next;

        ListNode* temp = head;

        while(temp != NULL && temp->next != NULL)
        {
            if(st.count(temp->next->val))
            {
                temp->next = temp->next->next;
            }
            else
            {
                temp = temp->next;
            }
        }

        return head;
    }
};

class Solution {
public:

    bool palindrome(string &str) {
        int i = 0;
        int j = str.size() - 1;

        while (i < j) {
            if (str[i] != str[j])
                return false;

            i++;
            j--;
        }

        return true;
    }

    int longestPalindrome(string s, string t) {

        int ans = 1;

        // Empty substring from t
        for (int i = 0; i < s.size(); i++) {
            for (int len = 1; i + len <= s.size(); len++) {

                string a = s.substr(i, len);

                if (palindrome(a)) {
                    ans = max(ans, (int)a.size());
                }
            }
        }

        // Empty substring from s
        for (int i = 0; i < t.size(); i++) {
            for (int len = 1; i + len <= t.size(); len++) {

                string b = t.substr(i, len);

                if (palindrome(b)) {
                    ans = max(ans, (int)b.size());
                }
            }
        }

        // Take substring from s + substring from t
        for (int i = 0; i < s.size(); i++) {
            for (int len1 = 1; i + len1 <= s.size(); len1++) {

                string a = s.substr(i, len1);

                for (int j = 0; j < t.size(); j++) {
                    for (int len2 = 1; j + len2 <= t.size(); len2++) {

                        string b = t.substr(j, len2);

                        string temp = a + b;

                        if (palindrome(temp)) {
                            ans = max(ans, (int)temp.size());
                        }
                    }
                }
            }
        }

        return ans;
    }
};

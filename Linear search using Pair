#include<iostream>
#include<climits>
using namespace std;
pair<int,int> Linear_search(int arr[][3],int key)
{
    for(int i=0;i<3;i++)
    {
        for(int j=0;j<3;j++)
        {
            if(arr[i][j]==key)
            {
                return {i,j};
            }
        }
    }
    return {-1,-1};
}
int main()
{
    int arr[3][3];
    cout<<"Enter array element"<<endl;
    for(int i=0;i<3;i++)
    {
        for(int j=0;j<3;j++)
        {
            cin>>arr[i][j];
        }
    }

    cout<<"Array Elements is:"<<endl;

    for(int i=0;i<3;i++)
    {
        for(int j=0;j<3;j++)
        {
            cout<<arr[j][i]<<" ";
        }
        cout<<endl;
    }

    int key=5;
    
    pair<int,int>ans=Linear_search(arr,key);
    cout<<ans.first<<" "<<ans.second;
    return 0;
}

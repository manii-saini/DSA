class Solution {
public:
    vector<vector<int>> matrixReshape(vector<vector<int>>& mat, int r, int c) {
        int m = mat.size();
        int n = mat[0].size();

        if(m * n != r * c)
        {
            return mat;
        }

        vector<vector<int>> ans1;

        int x = 0;
        int y = 0;

        for(int i = 0; i < r; i++)
        {
            vector<int> ans;

            for(int j = 0; j < c; j++)
            {
                ans.push_back(mat[x][y]);

                y++;

                if(y == n)
                {
                    y = 0;
                    x++;
                }
            }

            ans1.push_back(ans);
        }

        return ans1;
    }
};

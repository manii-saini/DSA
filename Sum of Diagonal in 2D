#include<iostream>
#include<climits>
using namespace std;
int main()
{
    int arr[3][3];
    cout<<"Enter array element"<<endl;
    for(int i=0;i<3;i++)
    {
        for(int j=0;j<3;j++)
        {
            cin>>arr[i][j];
        }
    }

    cout<<"Array Elements is:"<<endl;

    for(int i=0;i<3;i++)
    {
        for(int j=0;j<3;j++)
        {
            cout<<arr[i][j]<<" ";
        }
        cout<<endl;
    }


    int sum=0;

    for(int i=0;i<3;i++)
    {
        for(int j=0;j<3;j++)
        {
            if(i==j)
            {
                sum = sum + arr[i][j];
            }
            else if(j==3-i-1)
            {
                sum = sum + arr[i][j];
            }
        }
    }
    cout<<"The Diagonal sum is:"<<sum;
    return 0;
}

class Solution {
public:
    vector<string> commonChars(vector<string>& words) {
        
        vector<int> freq(26, INT_MAX);

        for(int i = 0; i < words.size(); i++)
        {
            vector<int> temp(26, 0);

            for(char ch : words[i])
            {
                temp[ch - 'a']++;
            }

            for(int j = 0; j < 26; j++)
            {
                freq[j] = min(freq[j], temp[j]);
            }
        }

        vector<string> ans;

        for(int i = 0; i < 26; i++)
        {
            while(freq[i] > 0)
            {
                string s(1, 'a' + i);
                ans.push_back(s);
                freq[i]--;
            }
        }

        return ans;
    }
};

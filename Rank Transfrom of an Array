class Solution {
public:
    vector<int> arrayRankTransform(vector<int>& arr) {

        vector<int> ans = arr;

        sort(ans.begin(), ans.end());

        ans.erase(unique(ans.begin(), ans.end()), ans.end());

        map<int, int> mp;

        for(int i = 0; i < ans.size(); i++)
        {
            mp[ans[i]] = i + 1;
        }

        vector<int> temp;

        for(int i = 0; i < arr.size(); i++)
        {
            temp.push_back(mp[arr[i]]);
        }

        return temp;
    }
};

class Solution {
public:
    
    vector<int> sortArrayByParityII(vector<int>& nums) {
        vector<int>ans;
        for(int i=0;i<nums.size();i++)
        {
            if(nums[i]%2==0)
            {
                ans.push_back(nums[i]);
            }
        }
        for(int i=0;i<nums.size();i++)
        {
            if(nums[i]%2!=0)
            {
                ans.push_back(nums[i]);
            }
        }

        vector<int>ans1;
        int start=0;
        int end=ans.size()-1;
        while(start<end)
        {
            ans1.push_back(ans[start]);
            ans1.push_back(ans[end]);
            start++;
            end--;
        }
        return ans1;
    }
};

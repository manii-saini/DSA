/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    int pairSum(ListNode* head) {
        if(head==NULL)
        {
            return 0;
        }
        vector<int>ans;
        ListNode* temp=head;
        while(temp!=NULL)
        {
            ans.push_back(temp->val);
            temp=temp->next;
        }

        int s=0;
        int e=ans.size()-1;
        int maxsum=INT_MIN;
        int minsum=INT_MAX;
        int sum=0;
        while(s<e)
        {
            sum=ans[s]+ans[e];
            maxsum=max(sum,maxsum);
            minsum=min(sum,minsum);
            s++;
            e--;
        }

        return maxsum;
    }
};

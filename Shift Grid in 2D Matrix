#include<iostream>
#include<vector>
using namespace std;
int main()
{
    vector<vector<int>>matrix={
        {1,2,3},
        {4,5,6},
        {7,8,9}
    };
    int k=2;

    cout<<"Before shift the grid:"<<endl;

    for(int i=0;i<matrix.size();i++)
    {
        for(int j=0;j<matrix[0].size();j++)
        {
            cout<<matrix[i][j]<<" ";
        }
        cout<<endl;
    }
    vector<int>temp;
    int m=matrix.size();
    int n=matrix[0].size();
    int total=m*n;
    k=k%total;
    for(int i=0;i<m;i++)
    {
        for(int j=0;j<n;j++)
        {
            temp.push_back(matrix[i][j]);
        }
    }

    vector<int>shifited(total);
    for(int i=0;i<total;i++)
    {
        shifited[(i+k)%total]=temp[i];
    }

    int index=0;
    for(int i=0;i<m;i++)
    {
        for(int j=0;j<n;j++)
        {
            matrix[i][j]=shifited[index++];
        }
    }
    
    cout<<"After Shift the Grid:"<<endl;
    
    for(int i=0;i<m;i++)
    {
        for(int j=0;j<n;j++)
        {
            cout<<matrix[i][j]<<" ";
        }
        cout<<endl;
    }
    return 0;
}

class Solution {
public:
    double minimumAverage(vector<int>& nums) {

        sort(nums.begin(),nums.end());

        int start=0;
        int end=nums.size()-1;
        double minaverage=INT_MAX;
        
        while(start<end)
        {
            double sum=nums[start]+nums[end];
            start++;
            end--;
            double ans=sum/2;
            minaverage=min(ans,minaverage);

        }

        return minaverage;
    }
};

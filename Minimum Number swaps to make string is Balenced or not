class Solution {
public:
    int minSwaps(string s) {
        int start = 0;
        int end = s.size() - 1;
        int count = 0;
        int ans = 0;

        while(start < end)
        {
            if(s[start] == '[')
            {
                count++;
                start++;
            }
            else
            {
                count--;
                
                if(count < 0)
                {
                    while(start < end && s[end] != '[')
                    {
                        end--;
                    }

                    swap(s[start], s[end]);
                    ans++;

                    count = 1;
                    start++;
                    end--;
                }
                else
                {
                    start++;
                }
            }
        }

        return ans;
    }
};

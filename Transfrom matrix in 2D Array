#include <iostream>
using namespace std;

int main()
{
    int arr[3][4];
    cout<<"Enter Array Elements:"<<endl;

    for (int row = 0; row < 3; row++)
    {
        for (int col = 0; col < 4; col++)
        {
            cin>>arr[row][col];
        }
    }

    cout << "simple matrix" << endl;

    for (int row = 0; row < 3; row++)
    {
        for (int col = 0; col < 4; col++)
        {
            cout << arr[row][col] << " ";
        }
        cout << endl;
    }

    cout << "Transfrom matrix" << endl;

    for (int row = 0; row < 3; row++)
    {
        for (int col = 0; col < 4; col++)
        {
            cout << arr[col][row] << " ";
        }
        cout << endl;
    }

    return 0;
}

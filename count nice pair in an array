class Solution {
public:
    int reverse(int n)
    {
        int rev = 0;

        while(n > 0)
        {
            int digit = n % 10;
            rev = rev * 10 + digit;
            n = n / 10;
        }

        return rev;
    }

    int countNicePairs(vector<int>& nums) {
        unordered_map<int, long long> mp;

        long long count = 0;
        int mod = 1000000007;

        for(int i = 0; i < nums.size(); i++)
        {
            int key = nums[i] - reverse(nums[i]);

            count = (count + mp[key]) % mod;

            mp[key]++;
        }

        return count;
    }
};

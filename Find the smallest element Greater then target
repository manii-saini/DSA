class Solution {
public:
    char nextGreatestLetter(vector<char>& letters, char target) {
        int start=0;
        int end=letters.size()-1;
        while(start<=end)
        {
            if(letters[start]>target)
            {
                return letters[start];
                break;
            }
            else
            {
                start++;
            }
        }
        return letters[0];
    }
};

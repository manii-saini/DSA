class Solution {
public:
    bool isvowel(char ch)
    {
        return ch=='a' || ch=='e' || ch=='i' || ch=='o' || ch=='u';
    }

    void reverse(string& s)
    {
        int start=0;
        int end=s.size()-1;

        while(start<end)
        {
            swap(s[start],s[end]);
            start++;
            end--;
        }
    }

    string reverseWords(string s) {
        stringstream ss(s);
        string word;

        vector<string> words;
        vector<int> ans;

        while(ss >> word)
        {
            int count=0;

            for(char ch:word)
            {
                if(isvowel(ch))
                {
                    count++;
                }
            }

            words.push_back(word);
            ans.push_back(count);
        }

        int fwvc=ans[0];

        for(int i=1; i<words.size(); i++)
        {
            if(ans[i] == fwvc)
            {
                reverse(words[i]);
            }
        }

        string result="";

        for(int i=0; i<words.size(); i++)
        {
            result += words[i];

            if(i != words.size()-1)
            {
                result += " ";
            }
        }

        return result;
    }
};

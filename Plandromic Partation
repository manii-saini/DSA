#include <iostream>
#include <vector>
#include <string>
#include<algorithm>
using namespace std;

bool isplan(string s)
{
    string s2=s;
    reverse(s2.begin(),s2.end());
    return s==s2;
}

void getAllPratation(string s,vector<string>&partation,vector<vector<string>>&ans)
{
    if(s.size()==0)
    {
        ans.push_back(partation);
        return;
    }

    for(int i=0;i<s.size();i++)
    {
        string part=s.substr(0,i+1);
        if(isplan(part))
        {
            partation.push_back(part);
            getAllPratation(s.substr(i+1),partation,ans);
            partation.pop_back();
        }
    }
}

vector<vector<string>> Partation(string s) {
    vector<string>partation;
    vector<vector<string>>ans;
    getAllPratation(s,partation,ans);
    return ans;
}

int main() {

    string s="aab";
    vector<vector<string>>ans=Partation(s);
    for(auto ch:ans)
    {
        for(auto ch1:ch)
        {
            cout<<ch1;
        }
        cout<<endl;
    }
    return 0;
}

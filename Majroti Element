#include<iostream>
#include<vector>
using namespace std;
int majroti(vector<int>nums)
{
    for(int val:nums)
    {
        int freq=0;
        for(int el:nums)
        {
            if(val==el)
            {
                freq++;
            }
        }
        if(freq>nums.size()/2)
        {
            return val;
        }
    }
    return -1;
}
int main()
{
    vector<int>nums={1,2,1,2,1};
    cout<<"find majroti element:"<<majroti(nums)<<endl;
    return 0;
}

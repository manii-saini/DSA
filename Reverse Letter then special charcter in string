class Solution {
public:
    string reverseByType(string s) {
        int start=0;
        int end=s.size()-1;
        while(start<end)
        {
            if(!isalpha(s[start]))
            {
                start++;
            }
            if(!isalpha(s[end]))
            {
                end--;
            }
            if(isalpha(s[start]) && isalpha(s[end]))
            {
                swap(s[start],s[end]);
                start++;
                end--;
            }
        }

        start=0;
        end=s.size()-1;
        while(start<end)
        {
            if(isalpha(s[start]))
            {
                start++;
            }
            if(isalpha(s[end]))
            {
                end--;
            }
            if(!isalpha(s[start]) && !isalpha(s[end]))
            {
                swap(s[start],s[end]);
                start++;
                end--;
            }
        }

        return s;
    }
};

#include<iostream>
#include<vector>
using namespace std;
int solve(string a,string b,int i,int j)
{
    if(i==a.size())
    {
        return 0;
    }

    if(j==b.size())
    {
        return 0;
    }
    int ans=0;

    if(a[i]==b[j])
    {
        ans=1+solve(a,b,i+1,j+1);
    }
    else
    {
        ans=max(solve(a,b,i+1,j),solve(a,b,i,j+1));
    }
    return ans;
}
int LongestCommomSubsequence(string a,string b)
{
    int ans1=solve(a,b,0,0);
    return ans1;
}
int main()
{
    string a="abc";
    string b="abcd";
    int ans2=LongestCommomSubsequence(a,b);
    cout<<"The LongestCommomSubsequence is:"<<ans2;
    return 0;
}

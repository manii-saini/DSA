class Solution {
public:
    string longestWord(vector<string>& words) {
        sort(words.begin(), words.end());

        unordered_set<string> st;
        string ans = "";

        for(int i = 0; i < words.size(); i++)
        {
            string word = words[i];

            if(word.size() == 1 || 
               st.find(word.substr(0, word.size() - 1)) != st.end())
            {
                st.insert(word);

                if(word.size() > ans.size())
                {
                    ans = word;
                }
            }
        }

        return ans;
    }
};

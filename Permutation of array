#include<iostream>
#include<vector>
using namespace std;
void solve(vector<int>&nums,int idx,vector<vector<int>>&ans)
{
    if(idx>=nums.size())
    {
        ans.push_back(nums);
        return;
    }

    for(int i=idx;i<nums.size();i++)
    {
        swap(nums[i],nums[idx]);
        solve(nums,idx+1,ans);
        swap(nums[i],nums[idx]);
    }
}
vector<vector<int>> permutation(vector<int>nums)
{
    vector<vector<int>>ans;
    int idx=0;
    solve(nums,idx,ans);
    return ans;
}
int main()
{
    vector<int>nums={1,2,3};
    vector<vector<int>>ans=permutation(nums);
    for(auto i:ans)
    {
        for(auto j:i)
        {
            cout<<j;
        }
        cout<<endl;
    }
    return 0;
}

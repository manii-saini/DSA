class Solution {
public:
    bool isAdjacentDiffAtMostTwo(string s) {
        int val1, val2;

        for(int i = 0; i + 1 < s.size(); i++)
        {
            val1 = s[i] - '0';
            val2 = s[i + 1] - '0';

            int diff = abs(val1 - val2);

            if(diff > 2)
            {
                return false;
            }
        }

        return true;
    }
};

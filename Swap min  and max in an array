#include <iostream>
using namespace std;


int main() {
    int arr[5] = {1, 2, 3, 4, 5};


    int maximum = 0;
    int minimum = 0;


    for (int i = 1; i < 5; i++) {
        if (arr[i] > arr[maximum]) {
            maximum = i;
        }
        if (arr[i] < arr[minimum]) {
            minimum = i;
        }
    }


    swap(arr[minimum], arr[maximum]);


    cout << "After swapping min and max element:" << endl;
    for (int i = 0; i < 5; i++) {
        cout << arr[i] << " ";
    }


    return 0;
}

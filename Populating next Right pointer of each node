class Solution {
public:
    Node* connect(Node* root) {
        
        if(root == NULL)
        {
            return NULL;
        }

        queue<Node*> q;
        
        q.push(root);
        q.push(NULL);

        Node* prev = NULL;

        while(!q.empty())
        {
            Node* temp = q.front();
            q.pop();

            if(temp == NULL)
            {
                // End of current level
                if(prev != NULL)
                {
                    prev->next = NULL;
                }

                if(!q.empty())
                {
                    q.push(NULL);
                }

                prev = NULL;
            }
            else
            {
                // Connect previous node with current node
                if(prev != NULL)
                {
                    prev->next = temp;
                }

                prev = temp;

                if(temp->left)
                {
                    q.push(temp->left);
                }

                if(temp->right)
                {
                    q.push(temp->right);
                }
            }
        }

        return root;
    }
};

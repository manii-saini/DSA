class Solution {
public:
    int minimumSwaps(vector<int>& nums) {
        int count = 0;
        int start = 0;
        int end = nums.size() - 1;

        while (start < end) {
            if (nums[start] == 0) {
                
                while (start < end && nums[end] == 0) {
                    end--;
                }

                if (start < end) {
                    swap(nums[start], nums[end]);
                    count++;
                    end--;
                }
            }

            start++;
        }

        return count;
    }
};

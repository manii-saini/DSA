#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
void merge_sort(int arr1[],int arr2[],int arr3[],int m,int n)
{
    int i,j,k;
    i=j=k=0;
    while(i<m && j<n)
    {
        if(arr1[i]>arr2[j])
        {
            arr3[k]=arr2[j];
            j++;
            k++;
        }
        else
        {
            arr3[k]=arr1[i];
            i++;
            k++;
        }
    }

    while(i<m)
    {
        arr3[k]=arr1[i];
        i++;
        k++;
    }

    while(j<n)
    {
        arr3[k]=arr2[j];
        j++;
        k++;
    }
}

void Print(int arr3[],int size)
{
    for(int i=0;i<size;i++)
    {
        cout<<arr3[i]<<" ";
    }
    cout<<endl;
}
int main()
{
    int m=5;
    int n=6;
    int size=m+n;
    int arr1[m]={1,5,2,4,3};
    sort(arr1,arr1+m);
    int arr2[n]={11,8,7,9,10,6};
    sort(arr2,arr2+n);
    int arr3[size];
    merge_sort(arr1,arr2,arr3,m,n);
    Print(arr3,size);
    return 0;
}

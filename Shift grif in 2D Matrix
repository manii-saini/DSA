class Solution {
public:
    vector<vector<int>> shiftGrid(vector<vector<int>>& grid, int k) {
        int m=grid.size();
        int n=grid[0].size();
        int total=m*n;
        k=k%total;
        vector<int>temp;
        for(int i=0;i<m;i++)
        {
            for(int j=0;j<n;j++)
            {
                temp.push_back(grid[i][j]);
            }
        }

        vector<int>shifted(total);

        for(int i=0;i<total;i++)
        {
            shifted[(i+k)%total]=temp[i];
        }

        int index=0;

        for(int i=0;i<m;i++)
        {
            for(int j=0;j<n;j++)
            {
                grid[i][j]=shifted[index++];
            }
        }

        return grid;
    }
};

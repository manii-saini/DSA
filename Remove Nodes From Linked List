class Solution {
public:
    ListNode* removeNodes(ListNode* head) {
        ListNode* temp = head;
        vector<int> ans;

        while(temp != NULL)
        {
            ans.push_back(temp->val);
            temp = temp->next;
        }

        vector<int> result;

        int maxi = -1;

        for(int i = ans.size() - 1; i >= 0; i--)
        {
            if(ans[i] >= maxi)
            {
                result.push_back(ans[i]);
                maxi = ans[i];
            }
        }

        reverse(result.begin(), result.end());

        temp = head;
        int i = 0;

        while(i < result.size())
        {
            temp->val = result[i];
            i++;

            if(i == result.size())
            {
                temp->next = NULL;
                break;
            }

            temp = temp->next;
        }

        return head;
    }
};

#include<iostream>
#include<vector>
using namespace std;
int main()
{
    vector<int>nums={6,3,5,2,7};
    int count=0;
    for(int i=0;i<nums.size();i++)
    {
        for(int j=i+1;j<nums.size();j++)
        {
            if(nums[i]>nums[j])
            {
                count++;
            }
        }
    }
    cout<<"Inversion Count:"<<count<<endl;
    return 0;
}

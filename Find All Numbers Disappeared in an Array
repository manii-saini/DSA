class Solution {
public:
    vector<int> findDisappearedNumbers(vector<int>& nums) {
        sort(nums.begin(),nums.end());
        set<int>s;
        vector<int>ans;
        int n=nums.size();

        for(int i=0;i<n;i++)
        {
            s.insert(nums[i]);
        }

        for(int i=1;i<=n;i++)
        {
            if(s.find(i)!=s.end())
            {
                continue;
            }
            else
            {
                ans.push_back(i);
            }
        }
        return ans;
    }
};

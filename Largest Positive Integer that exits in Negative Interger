class Solution {
public:
    int findMaxK(vector<int>& nums) {
        int start=0;
        int end=nums.size()-1;
        sort(nums.begin(),nums.end());
        while(start<end)
        {
            if(nums[start]+nums[end]==0)
            {
                return nums[end];
            }
            else if(nums[start]+nums[end]>0)
            {
                end--;
            }
            else
            {
                start++;
            }
        }
        return -1;
    }
};

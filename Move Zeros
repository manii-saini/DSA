class Solution {
public:
    void moveZeroes(vector<int>& nums) {
        int k=0;
        vector<int>ans;
        for(int i=0;i<nums.size();i++)
        {   
            if(nums[i]==0)
            {
                k++;
            }
            else
            {
                ans.push_back(nums[i]);
            }
        }

        while(k!=0)
        {
            ans.push_back(0);
            k--;
        }

         for (int i = 0; i < nums.size(); i++) {
            nums[i] = ans[i];
        }
    }
};

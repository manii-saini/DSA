#include<iostream>
#include<vector>
using namespace std;
void solve(string nums,int idx,vector<string>&ans)
{
    if(idx>=nums.size())
    {
        ans.push_back(nums);
        return;
    }

    for(int i=idx;i<nums.size();i++)
    {
        swap(nums[i],nums[idx]);
        solve(nums,idx+1,ans);
        swap(nums[i],nums[idx]);
    }
}
vector<string> permutation(string nums)
{
    vector<string>ans;
    int idx=0;
    solve(nums,idx,ans);
    return ans;
}
int main()
{
    string nums="abc";
    vector<string>ans=permutation(nums);
    for(auto i:ans)
    {
        cout<<i<<endl;
    }
    return 0;
}

#include<iostream>
#include<vector>
#include<list>
#include<deque>
#include<stack>
#include<queue>
#include<map>
#include<unordered_map>
#include<set>
#include<unordered_set>
#include<algorithm>
using namespace std;
int main()
{   
    queue<int>s;
    s.push(10);
    s.push(20);
    s.push(30);
    s.emplace(40);
    s.emplace(50);
    cout<<"size:"<<s.size()<<endl;
    while(!s.empty())
    {
        cout<<s.front()<<" ";
        s.pop();
    }
    cout<<endl;
    cout<<"Empty:"<<s.empty()<<endl;

    queue<int>s1;
    s1.swap(s);
    while(!s1.empty())
    {
        cout<<s1.front()<<" ";
        s1.pop();
    }
    cout<<endl;
    return 0;
}

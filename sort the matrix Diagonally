class Solution {
public:
    vector<vector<int>> diagonalSort(vector<vector<int>>& mat) {

        int m = mat.size();
        int n = mat[0].size();

        // Start from first row
        for(int col = 0; col < n; col++)
        {
            vector<int> temp;

            int i = 0;
            int j = col;

            // Collect diagonal
            while(i < m && j < n)
            {
                temp.push_back(mat[i][j]);
                i++;
                j++;
            }

            // Sort diagonal
            sort(temp.begin(), temp.end());

            // Put back
            i = 0;
            j = col;

            int k = 0;

            while(i < m && j < n)
            {
                mat[i][j] = temp[k];
                k++;
                i++;
                j++;
            }
        }

        // Start from first column, skipping [0][0]
        for(int row = 1; row < m; row++)
        {
            vector<int> temp;

            int i = row;
            int j = 0;

            // Collect diagonal
            while(i < m && j < n)
            {
                temp.push_back(mat[i][j]);
                i++;
                j++;
            }

            // Sort
            sort(temp.begin(), temp.end());

            // Put back
            i = row;
            j = 0;

            int k = 0;

            while(i < m && j < n)
            {
                mat[i][j] = temp[k];
                k++;
                i++;
                j++;
            }
        }

        return mat;
    }
};

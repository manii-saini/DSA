class Solution {
public:
    string reverseWords(string s) {
        stringstream ss(s);
        string word;
        vector<string>ans;
        while(ss >> word)
        {
            ans.push_back(word);
        }   
        
        string ans1="";
        for(int i=ans.size()-1;i>=0;i--)
        {
            if(i==0)
            {
                ans1+=ans[i];
            }
            else
            {
                ans1+=ans[i]+" ";
            }
        }
        return ans1;
    }
};

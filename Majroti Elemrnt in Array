class Solution {
public:
    int majorityElement(vector<int>& nums) {
        unordered_map<int,int>m;
        for(int i=0;i<nums.size();i++)
        {
            m[nums[i]]++;
        }
        int number;
        int maxfreq=0;
        for(auto x:m)
        {
            if(x.second>maxfreq)
            {
                maxfreq=x.second;
                number=x.first;
            }
        }
        return number;
    }
};

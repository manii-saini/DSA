class Solution {
public:
    vector<int> majorityElement(vector<int>& nums) {
        set<int>s;
        vector<int>ans;
        for(int i=0;i<nums.size();i++)
        {
            int freq=0;

            for(int j=i;j<nums.size();j++)
            {
                if(nums[i]==nums[j])
                    freq++;
            }

            if(freq>nums.size()/3)
            {
                s.insert(nums[i]);
            }
        }
        for(int val:s)
        {
            ans.push_back(val);
        }

        return ans;
    }
};

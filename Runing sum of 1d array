class Solution {
public:
    vector<int> runningSum(vector<int>& nums) {
        vector<int>ans;
        for(int i=0;i<nums.size();i++)
        {
            int sum=0;
            int k=0;
            for(int k=0;k<=i;k++)
            {
                sum=sum+nums[k];
            }
            ans.push_back(sum);
        }
        return ans;
    }
};

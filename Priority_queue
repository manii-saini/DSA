#include<algorithm>
using namespace std;
int main()
{   
    // max Priority queue
    priority_queue<int>s;
    s.push(10);
    s.push(60);
    s.push(20);
    s.emplace(40);
    s.emplace(100);
    cout<<"size:"<<s.size()<<endl;
    while(!s.empty())
    {
        cout<<s.top()<<" ";
        s.pop();
    }

    cout<<endl;
    cout<<endl;

    // min Priority_ queue
    priority_queue<int,vector<int>,greater<int>>p1;
    p1.push(45);
    p1.push(33);
    p1.push(35);
    p1.push(78);
    cout<<"size:"<<p1.size()<<endl;
    while(!p1.empty())
    {
        cout<<p1.top()<<" ";
        p1.pop();
    }
    return 0;
}


class Solution {
public:
    ListNode* swapNodes(ListNode* head, int k) {
        vector<int>ans;
        ListNode* temp=head;
        while(temp!=NULL)
        {
            ans.push_back(temp->val);
            temp=temp->next;
        }  

        swap(ans[k-1],ans[ans.size()-k]);

        int i=0;
        temp=head;
        while(temp!=NULL)
        {
            temp->val=ans[i];
            temp=temp->next;
            i++;
        }

        return head;
    }
};
